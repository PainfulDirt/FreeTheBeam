# Creality LiDAR module (CH343 USB serial, 1a86:55d3): the same name as on
# the K1 (lidar-direct.py's default port), readable by the dialout group.
# Pinned to this module's USB serial number (host/install.sh fills it in):
# other CH343 devices, e.g. a printer board, must never get this name.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="MODULE_SERIAL", SYMLINK+="serial/by-id/creality-laser", MODE="0660", GROUP="dialout"
